# 域名配置
MONOPOLY_DOMAIN=localhost
PROTOCOL=http

# 路径前缀配置（留空=端口模式，设置后使用 nginx 路径反代）
# API_BASE_PREFIX=/monopoly-server
# ICE_BASE_PREFIX=/monopoly-ice （留空跟随 API_BASE_PREFIX）
# ADMIN_BASE_PREFIX=/monopoly-admin （留空跟随 API_BASE_PREFIX）
API_BASE_PREFIX=
ICE_BASE_PREFIX=
ADMIN_BASE_PREFIX=

# 服务端口配置
SERVER_PORT=81
ICE_SERVER_PORT=82
MONOPOLY_ADMIN_PORT=83

# MySQL 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=monopoly
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# MySQL 连接池配置（可选，有默认值）
# MYSQL_POOL_SIZE=20
# MYSQL_ACQUIRE_TIMEOUT=30000

# 运行环境
NODE_ENV=development

# TURN 服务器配置
TURN_SECRET=your-random-secret-key-change-in-production
TURN_TTL=86400
TURN_URL=localhost
TURN_PORT=5349
STUN_PORT=3478
# 是否给浏览器下发 turns:（TURN over TLS）。留空时跟随 PROTOCOL：https 开、http 关。
# coturn 没在 TURN_PORT 上起 TLS、或者用裸 IP 部署（公共 CA 不给 IP 签证书）时必须设 false，
# 否则浏览器每次建连都要为这条连不上的 turns: 白等一轮超时。
# 用 `node scripts/check-turn.mjs` 可以直接测出来能不能开。
# TURN_TLS_ENABLED=false

# Coturn 指标地址（服务器用于获取 Prometheus 指标）
COTURN_METRICS_URL=http://monopoly-coturn:9641/metrics

# 可选：腾讯云 COS 对象存储配置
# TC_ID=
# TC_KEY=
# TC_BUCKET_NAME=
# TC_REGION=
# COS_TIMEOUT=60000

# 文件存储路径配置
# AVATAR_STORAGE_PATH=user/avatars
# GAME_MAP_STORAGE_PATH=monopoly/game-map

# 地图产物文件加密密钥（16 位 ASCII 字符）
MAP_ENCRYPT_KEY=changeme16chkey!
